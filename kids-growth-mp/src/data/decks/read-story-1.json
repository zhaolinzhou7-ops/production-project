{
  "key": "read-story-1",
  "name": "亲子共读·小故事",
  "subject": "语文",
  "itemType": "poem",
  "source": "原创短故事 20 篇,每篇 5 句,用词控制在幼儿常用范围内;可朗读、可让孩子复述",
  "count": 20,
  "cards": [
    {
      "title": "小蚂蚁搬米粒",
      "author": "",
      "dynasty": "",
      "lines": [
        "小蚂蚁找到一粒米。",
        "米粒太大了,搬不动。",
        "它回家叫来了好多同伴。",
        "大家一起抬,米粒动了。",
        "小蚂蚁说:人多力量大。"
      ]
    },
    {
      "title": "小鸭子学游泳",
      "author": "",
      "dynasty": "",
      "lines": [
        "小鸭子第一次下水。",
        "它有点怕,不敢往前走。",
        "妈妈说:别怕,我在旁边。",
        "小鸭子伸出脚,划了一下。",
        "咦,它真的浮起来了!"
      ]
    },
    {
      "title": "会说话的小树",
      "author": "",
      "dynasty": "",
      "lines": [
        "院子里有一棵小树。",
        "小明每天给它浇水。",
        "小树一天天长高了。",
        "风一吹,叶子沙沙响。",
        "小明说:小树在跟我说话呢。"
      ]
    },
    {
      "title": "藏起来的太阳",
      "author": "",
      "dynasty": "",
      "lines": [
        "早上,太阳不见了。",
        "天灰灰的,还下起了雨。",
        "小兔子撑起一把伞。",
        "雨停了,太阳露出笑脸。",
        "原来它只是躲在云后面。"
      ]
    },
    {
      "title": "小猫钓鱼",
      "author": "",
      "dynasty": "",
      "lines": [
        "小猫拿着鱼竿去河边。",
        "蝴蝶飞来,它去追蝴蝶。",
        "蜻蜓飞来,它又去追蜻蜓。",
        "太阳下山了,一条鱼也没钓到。",
        "小猫说:明天我要专心。"
      ]
    },
    {
      "title": "最好吃的饭",
      "author": "",
      "dynasty": "",
      "lines": [
        "小刚说他不爱吃青菜。",
        "这天他跟着奶奶去种菜。",
        "浇水、拔草,忙了一下午。",
        "晚上桌上有一盘青菜。",
        "小刚吃得一片都不剩。"
      ]
    },
    {
      "title": "谁的尾巴长",
      "author": "",
      "dynasty": "",
      "lines": [
        "小松鼠的尾巴又大又蓬松。",
        "小猴子的尾巴又细又长。",
        "小兔子的尾巴短短的。",
        "它们比来比去,谁也不服。",
        "妈妈说:尾巴各有各的用处。"
      ]
    },
    {
      "title": "下雨天的伞",
      "author": "",
      "dynasty": "",
      "lines": [
        "小美带了一把伞去上学。",
        "放学时,同桌没有伞。",
        "小美说:我们一起走吧。",
        "两个人挤在一把伞下。",
        "小美的肩膀湿了一半。"
      ]
    },
    {
      "title": "会飞的种子",
      "author": "",
      "dynasty": "",
      "lines": [
        "蒲公英的种子长着小伞。",
        "风一吹,它们就飞起来。",
        "有的落在山坡上。",
        "有的落在小河边。",
        "明年春天,那里会开出花。"
      ]
    },
    {
      "title": "小熊的储蓄罐",
      "author": "",
      "dynasty": "",
      "lines": [
        "小熊有一个储蓄罐。",
        "每天他都放进一枚硬币。",
        "半年后,罐子满了。",
        "他用这些钱买了一本书。",
        "小熊说:一点一点也能变多。"
      ]
    },
    {
      "title": "影子朋友",
      "author": "",
      "dynasty": "",
      "lines": [
        "太阳出来,影子跟着我。",
        "我走,它也走。",
        "我跳,它也跳。",
        "我躲到大树下面。",
        "咦,影子怎么不见了?"
      ]
    },
    {
      "title": "小青蛙的家",
      "author": "",
      "dynasty": "",
      "lines": [
        "小青蛙住在荷叶上。",
        "荷叶又圆又绿,像小船。",
        "下雨的时候,它躲在下面。",
        "天晴了,它跳进水里。",
        "荷叶是它最喜欢的家。"
      ]
    },
    {
      "title": "第一次刷牙",
      "author": "",
      "dynasty": "",
      "lines": [
        "小宝第一次自己刷牙。",
        "牙膏挤多了,满嘴泡泡。",
        "他对着镜子哈哈大笑。",
        "刷完以后,牙齿白白的。",
        "从此他每天都自己刷。"
      ]
    },
    {
      "title": "排队的小朋友",
      "author": "",
      "dynasty": "",
      "lines": [
        "滑梯前面排了一队人。",
        "小乐想插到最前面。",
        "前面的小朋友说:要排队哦。",
        "小乐红着脸走到后面。",
        "轮到他时,他玩得最开心。"
      ]
    },
    {
      "title": "摔倒了",
      "author": "",
      "dynasty": "",
      "lines": [
        "小东跑步的时候摔倒了。",
        "膝盖破了,有点疼。",
        "他忍住眼泪,自己站起来。",
        "妈妈帮他擦了药。",
        "第二天,他又去跑步了。"
      ]
    },
    {
      "title": "会变的水",
      "author": "",
      "dynasty": "",
      "lines": [
        "水放进冰箱,变成了冰。",
        "冰放在太阳下,又变回水。",
        "水烧开了,变成白汽。",
        "白汽飘上天,变成了云。",
        "云再落下来,就是雨。"
      ]
    },
    {
      "title": "小蜗牛的房子",
      "author": "",
      "dynasty": "",
      "lines": [
        "小蜗牛背着房子走路。",
        "别人笑它走得慢。",
        "下雨了,大家都跑去躲雨。",
        "小蜗牛不慌不忙缩进房子。",
        "它说:我的家一直在身上。"
      ]
    },
    {
      "title": "谢谢你",
      "author": "",
      "dynasty": "",
      "lines": [
        "奶奶给小丽织了一条围巾。",
        "小丽戴上,暖暖的。",
        "她说:谢谢奶奶。",
        "奶奶笑得眼睛眯成一条缝。",
        "原来一句谢谢这么好听。"
      ]
    },
    {
      "title": "找妈妈",
      "author": "",
      "dynasty": "",
      "lines": [
        "小鸡走丢了,找不到妈妈。",
        "它问小鸭:你看见我妈妈了吗?",
        "又问小狗:你看见我妈妈了吗?",
        "这时传来咯咯咯的声音。",
        "小鸡飞快地跑了过去。"
      ]
    },
    {
      "title": "我长大了",
      "author": "",
      "dynasty": "",
      "lines": [
        "以前我不会自己穿衣服。",
        "现在我会了。",
        "以前我怕黑,不敢关灯。",
        "现在我敢了。",
        "妈妈说:你真的长大了。"
      ]
    }
  ]
}
