{"key":"poems-primary","name":"小学·唐诗启蒙","subject":"语文","itemType":"poem","source":"chinese-poetry 唐诗三百首(绝句) · OpenCC 繁转简","count":103,"cards":[{"title":"出塞","author":"王昌龄","dynasty":"唐","lines":["秦时明月汉时关","万里长征人未还","但使龙城飞将在","不教胡马度阴山"]},{"title":"出塞","author":"王之涣","dynasty":"唐","lines":["黄砂直上白云间","一片孤城万仞山","羌笛何须怨杨柳","春风不度玉门关"]},{"title":"新嫁娘词三首","author":"王建","dynasty":"唐","lines":["三日入厨下","洗手作羹汤","未谙姑食性","先遣小姑尝"]},{"title":"故行宫","author":"王建","dynasty":"唐","lines":["寥落古行宫","宫花寂寞红","白头宫女在","闲坐说玄宗"]},{"title":"乐游原","author":"李商隐","dynasty":"唐","lines":["向晚意不适","驱车登古原","夕阳无限好","只是近黄昏"]},{"title":"夜雨寄北","author":"李商隐","dynasty":"唐","lines":["君问归期未有期","巴山夜雨涨秋池","何当共剪西窗烛","却话巴山夜雨时"]},{"title":"寄令狐郎中","author":"李商隐","dynasty":"唐","lines":["嵩云秦树久离居","双鲤迢迢一纸书","休问梁园旧宾客","茂陵秋雨病相如"]},{"title":"隋宫","author":"李商隐","dynasty":"唐","lines":["乘兴南游不戒严","九重谁省谏书函","春风举国裁宫锦","半作障泥半作帆"]},{"title":"为有","author":"李商隐","dynasty":"唐","lines":["为有云屏无限娇","凤城寒尽怕春宵","无端嫁得金龟壻","辜负香衾事早朝"]},{"title":"瑶池","author":"李商隐","dynasty":"唐","lines":["瑶池阿母绮窗开","黄竹歌声动地哀","八骏日行三万里","穆王何事不重来"]},{"title":"常娥","author":"李商隐","dynasty":"唐","lines":["云母屏风烛影深","长河渐落晓星沈","常娥应悔偷灵药","碧海青天夜夜心"]},{"title":"贾生","author":"李商隐","dynasty":"唐","lines":["宣室求贤访逐臣","贾生才调更无伦","可怜夜半虚前席","不问苍生问鬼神"]},{"title":"赤壁","author":"李商隐","dynasty":"唐","lines":["折戟沈沙铁未销","自将磨洗认前朝","东风不与周郎便","铜雀春深锁二乔"]},{"title":"金陵图","author":"韦庄","dynasty":"唐","lines":["谁谓伤心画不成","画人心逐世人情","君看六幅南朝事","老木寒云满故城"]},{"title":"台城","author":"韦庄","dynasty":"唐","lines":["江雨霏霏江草齐","六朝如梦鸟空啼","无情最是台城柳","依旧烟笼十里堤"]},{"title":"春怨","author":"金昌绪","dynasty":"唐","lines":["打起黄莺儿","莫教枝上啼","啼时惊妾梦","不得到辽西"]},{"title":"行宫","author":"元稹","dynasty":"唐","lines":["寥落古行宫","宫花寂寞红","白头宫女在","闲坐说玄宗"]},{"title":"哥舒歌","author":"西鄙人","dynasty":"唐","lines":["北斗七星高","哥舒夜带刀","至今窥牧马","不敢过临洮"]},{"title":"杂诗","author":"无名氏","dynasty":"唐","lines":["近寒食雨草萋萋","著麦苗风柳映堤","早是有家归未得","杜鹃休向耳边啼"]},{"title":"桃花溪","author":"张旭","dynasty":"唐","lines":["隐隐飞桥隔野烟","石矶西畔问渔船","桃花尽日随流水","洞在清溪何处边"]},{"title":"玉台体十二首","author":"权德舆","dynasty":"唐","lines":["昨夜裙带解","今朝蟢子飞","铅华不可弃","莫是藁砧归"]},{"title":"已凉","author":"韩偓","dynasty":"唐","lines":["碧阑干外绣帘垂","猩血屏风画折枝","八尺龙须方锦褥","已凉天气未寒时"]},{"title":"将赴吴兴登乐游原一绝","author":"杜牧","dynasty":"唐","lines":["清时有味是无能","闲爱孤云静爱僧","欲把一麾江海去","乐游原上望昭陵"]},{"title":"赤壁","author":"杜牧","dynasty":"唐","lines":["折戟沈沙铁未销","自将磨洗认前朝","东风不与周郎便","铜雀春深鏁二乔"]},{"title":"泊秦淮","author":"杜牧","dynasty":"唐","lines":["烟笼寒水月笼沙","夜泊秦淮近酒家","商女不知亡国恨","隔江犹唱后庭花"]},{"title":"赠别二首","author":"杜牧","dynasty":"唐","lines":["娉娉褭褭十三余","豆蔻梢头二月初","春风十里扬州路","卷上珠帘总不如"]},{"title":"遣怀","author":"杜牧","dynasty":"唐","lines":["落魄江南载酒行","楚腰肠断掌中轻","十年一觉扬州梦","赢得青楼薄幸名"]},{"title":"秋夕","author":"杜牧","dynasty":"唐","lines":["红烛秋光冷画屏","轻罗小扇扑流萤","天阶夜色凉如水","坐看牵牛织女星"]},{"title":"金谷园","author":"杜牧","dynasty":"唐","lines":["繁华事散逐香尘","流水无情草自春","日暮东风怨啼鸟","落花犹似堕楼人"]},{"title":"寄人","author":"张泌","dynasty":"唐","lines":["别梦依依到谢家","小廊回合曲阑斜","多情只有春庭月","犹为离人照落花"]},{"title":"陇西行四首","author":"陈陶","dynasty":"唐","lines":["誓扫匈奴不顾身","五千貂锦丧胡尘","可怜无定河边骨","犹是春闺梦里人"]},{"title":"颂古三十二首","author":"释明辩","dynasty":"唐","lines":["打起黄莺儿","莫教枝上啼","几回惊妾梦","不得到辽西"]},{"title":"后宫词","author":"白居易","dynasty":"唐","lines":["泪湿罗巾梦不成","夜深前殿按歌声","红颜未老恩先断","斜倚薰笼坐到明"]},{"title":"江南词","author":"李益","dynasty":"唐","lines":["嫁得瞿塘贾","朝朝悮妾期","早知潮有信","嫁与弄潮儿"]},{"title":"夜上受降城闻笛","author":"李益","dynasty":"唐","lines":["回乐峰前沙似雪","受降城下月如霜","不知何处吹芦管","一夜征人尽望乡"]},{"title":"听筝","author":"李端","dynasty":"唐","lines":["鸣筝金粟柱","素手玉房前","欲得周郎顾","时时误拂弦"]},{"title":"听弹琴","author":"刘长卿","dynasty":"唐","lines":["泠泠七丝上","静听松风寒","古调虽自爱","今人多不弹"]},{"title":"送方外上人","author":"刘长卿","dynasty":"唐","lines":["孤云将野鹤","岂向人间住","莫买沃洲山","时人已知处"]},{"title":"送灵澈上人","author":"刘长卿","dynasty":"唐","lines":["苍苍竹林寺","杳杳钟声晚","荷笠带夕阳","青山独归远"]},{"title":"凉州词二首","author":"王翰","dynasty":"唐","lines":["葡萄美酒夜光杯","欲饮琵琶马上催","醉卧沙场君莫笑","古来征战几人回"]},{"title":"春晓","author":"孟浩然","dynasty":"唐","lines":["春眠不觉晓","处处闻啼鸟","夜来风雨声","花落知多少"]},{"title":"宿建德江","author":"孟浩然","dynasty":"唐","lines":["移舟泊烟渚","日暮客愁新","野旷天低树","江清月近人"]},{"title":"和张仆射塞下曲","author":"卢纶","dynasty":"唐","lines":["鹫翎金仆姑","燕尾绣蝥弧","独立扬新令","千营共一呼"]},{"title":"鹿柴","author":"王维","dynasty":"唐","lines":["空山不见人","但闻人语响","返景入深林","复照青苔上"]},{"title":"竹里馆","author":"王维","dynasty":"唐","lines":["独坐幽篁里","弹琴复长啸","深林人不知","明月来相照"]},{"title":"送别","author":"王维","dynasty":"唐","lines":["山中相送罢","日暮掩柴扉","春草明年绿","王孙归不归"]},{"title":"杂诗三首","author":"王维","dynasty":"唐","lines":["君自故乡来","应知故乡事","来日绮窗前","寒梅着花未"]},{"title":"相思","author":"王维","dynasty":"唐","lines":["红豆生南国","秋来发故枝","愿君多采撷","此物最相思"]},{"title":"九月九日忆山东兄弟","author":"王维","dynasty":"唐","lines":["独在异乡为异客","每逢佳节倍思亲","遥知兄弟登高处","遍插茱萸少一人"]},{"title":"渭城曲","author":"王维","dynasty":"唐","lines":["渭城朝雨浥轻尘","客舍青青杨柳春","劝君更尽一杯酒","西出阳关无故人"]},{"title":"崔九欲往南山马上口号与别","author":"裴迪","dynasty":"唐","lines":["归山深浅去","须尽丘壑美","莫学武陵人","暂游桃源里"]},{"title":"长干曲四首","author":"崔颢","dynasty":"唐","lines":["君家何处住","妾住在横塘","停船暂借问","或恐是同乡"]},{"title":"终南望余雪","author":"祖咏","dynasty":"唐","lines":["终南阴岭秀","积雪浮云端","林表明霁色","城中增暮寒"]},{"title":"出塞二首","author":"王昌龄","dynasty":"唐","lines":["秦时明月汉时关","万里长征人未还","但使龙城飞将在","不教胡马度阴山"]},{"title":"春宫曲","author":"王昌龄","dynasty":"唐","lines":["昨夜风开露井桃","未央前殿月轮高","平阳歌舞新承宠","帘外春寒赐锦袍"]},{"title":"闺怨","author":"王昌龄","dynasty":"唐","lines":["闺中少妇不曾愁","春日凝妆上翠楼","忽见陌头杨柳色","悔教夫壻觅封侯"]},{"title":"芙蓉楼送辛渐二首","author":"王昌龄","dynasty":"唐","lines":["寒雨连天夜入湖","平明送客楚山孤","洛阳亲友如相问","一片冰心在玉壶"]},{"title":"清平调","author":"李白","dynasty":"唐","lines":["云想衣裳花想容","春风拂槛露华浓","若非群玉山头见","会向瑶台月下逢"]},{"title":"还乡偶书","author":"黄拱","dynasty":"唐","lines":["少小离家老大回","乡音难改鬓毛衰","儿童相见不相识","借问客从何处来"]},{"title":"问刘十九","author":"白居易","dynasty":"唐","lines":["绿螘新醅酒","红泥小火垆","晚来天欲雪","能饮一杯无"]},{"title":"寻隐者不遇","author":"贾岛","dynasty":"唐","lines":["松下问童子","言师采药去","只在此山中","云深不知处"]},{"title":"瑶瑟怨","author":"温庭筠","dynasty":"唐","lines":["冰簟银床梦不成","碧天如水夜云轻","雁声远过潇湘去","十二楼中月自明"]},{"title":"渡汉江","author":"李频","dynasty":"唐","lines":["岭外音书绝","经年复历春","近乡情更怯","不敢问来人"]},{"title":"宫词二首","author":"张祜","dynasty":"唐","lines":["故国三千里","深宫二十年","一声河满子","双泪落君前"]},{"title":"赠内人","author":"张祜","dynasty":"唐","lines":["禁门宫树月痕过","媚眼唯看宿燕窠","斜拔玉钗灯影畔","剔开红焰救飞蛾"]},{"title":"集灵台二首","author":"张祜","dynasty":"唐","lines":["日光斜照集灵台","红树花迎晓露开","昨夜上皇新授箓","太真含笑入帘来"]},{"title":"题金陵渡","author":"张祜","dynasty":"唐","lines":["金陵津渡小山楼","一宿行人自可愁","潮落夜江斜月里","两三星火是瓜州"]},{"title":"宫词","author":"朱庆余","dynasty":"唐","lines":["寂寂花时闭院门","美人相并立琼轩","含情欲说宫中事","鹦鹉前头不敢言"]},{"title":"秋夜曲","author":"王涯","dynasty":"唐","lines":["桂魄初生秋露微","轻罗已薄未更衣","银筝夜久殷勤弄","心怯空房不忍归"]},{"title":"江雪","author":"柳宗元","dynasty":"唐","lines":["千山鸟飞绝","万径人踪灭","孤舟蓑笠翁","独钓寒江雪"]},{"title":"八阵图","author":"杜甫","dynasty":"唐","lines":["功盖三分国","名高八阵图","江流石不转","遗恨失吞吴"]},{"title":"江南逢李龟年","author":"杜甫","dynasty":"唐","lines":["歧王宅里寻常见","崔九堂前几度闻","正是江南好风景","落花时节又逢君"]},{"title":"虢国夫人","author":"杜甫","dynasty":"唐","lines":["虢国夫人承主恩","平明上马入宫门","却嫌脂粉涴颜色","澹埽蛾眉朝至尊"]},{"title":"渡汉江","author":"宋之问","dynasty":"唐","lines":["岭外音书断","经冬复历春","近乡情更怯","不敢问来人"]},{"title":"登楼","author":"朱斌","dynasty":"唐","lines":["白日依山尽","黄河入海流","欲穷千里目","更上一层楼"]},{"title":"寄人二首","author":"张佖","dynasty":"唐","lines":["别梦依依到谢家","小廊回合曲阑斜","多情只有春庭月","犹为离人照落花"]},{"title":"盖罗缝","author":"不详","dynasty":"唐","lines":["秦时明月汉时关","万里征人尚未还","但愿龙庭神将在","不教胡马渡阴山"]},{"title":"婆罗门","author":"杨敬述进","dynasty":"唐","lines":["回乐峰前沙似雪","受降城外月如霜","不知何处吹芦管","一夜征人尽望乡"]},{"title":"金缕衣","author":"不详","dynasty":"唐","lines":["劝君莫惜金缕衣","劝君惜取少年时","花开堪折直须折","莫待无花空折枝"]},{"title":"乌衣巷","author":"刘禹锡","dynasty":"唐","lines":["朱雀桥边野草花","乌衣巷口夕阳斜","旧时王谢堂前燕","飞入寻常百姓家"]},{"title":"和乐天春词","author":"刘禹锡","dynasty":"唐","lines":["新妆面面下朱楼","深锁春光一院愁","行到中庭数花朵","蜻蜓飞上玉搔头"]},{"title":"度南涧","author":"蔡襄","dynasty":"唐","lines":["隠隠飞桥隔野烟","石矶西畔问渔船","桃花尽日随流水","洞在清溪何处边"]},{"title":"和张仆射塞下曲","author":"钱起","dynasty":"唐","lines":["月黑雁飞高","单于夜遁逃","欲将轻骑逐","大雪满弓刀"]},{"title":"枫桥夜泊","author":"张继","dynasty":"唐","lines":["月落乌啼霜满天","江枫渔父对愁眠","姑苏城外寒山寺","夜半钟声到客船"]},{"title":"寒食","author":"韩翃","dynasty":"唐","lines":["春城无处不飞花","寒食东风御柳斜","日暮汉宫传蜡烛","轻烟散入五侯家"]},{"title":"秋夜寄丘二十二员外","author":"韦应物","dynasty":"唐","lines":["怀君属秋夜","散步咏凉天","山空松子落","幽人应未眠"]},{"title":"滁州西涧","author":"韦应物","dynasty":"唐","lines":["独怜幽草涧边生","上有黄鹂深树鸣","春潮带雨晚来急","野渡无人舟自横"]},{"title":"逢入京使","author":"岑参","dynasty":"唐","lines":["故园东望路漫漫","双袖龙钟泪不干","马上相逢无纸笔","凭君传语报平安"]},{"title":"访羊尊师","author":"孙革","dynasty":"唐","lines":["松下问童子","言师采药去","只在此山中","云深不知处"]},{"title":"玉阶怨","author":"李白","dynasty":"唐","lines":["玉阶生白露","夜久侵罗袜","却下水晶帘","玲珑望秋月"]},{"title":"清平调词三首","author":"李白","dynasty":"唐","lines":["云想衣裳花想容","春风拂槛露华浓","若非群玉山头见","会向瑶台月下逢"]},{"title":"静夜思","author":"李白","dynasty":"唐","lines":["床前看月光","疑是地上霜","举头望山月","低头思故乡"]},{"title":"黄鹤楼送孟浩然之广陵","author":"李白","dynasty":"唐","lines":["故人西辞黄鹤楼","烟花三月下扬州","孤帆远影碧山尽","唯见长江天际流"]},{"title":"早发白帝城","author":"李白","dynasty":"唐","lines":["朝辞白帝彩云间","千里江陵一日还","两岸猨声啼不尽","轻舟已过万重山"]},{"title":"怨情","author":"李白","dynasty":"唐","lines":["美人卷珠帘","深坐颦蛾眉","但见泪痕湿","不知心恨谁"]},{"title":"江南曲","author":"李益","dynasty":"唐","lines":["嫁得瞿塘贾","朝朝误妾期","早知潮有信","嫁与弄潮儿"]},{"title":"长信怨","author":"王昌龄","dynasty":"唐","lines":["奉帚平明金殿开","暂将团扇共裴回","玉颜不及寒鵶色","犹带昭阳日影来"]},{"title":"夜月","author":"刘方平","dynasty":"唐","lines":["更深月色半人家","北斗阑干南斗斜","今夜偏知春气暖","虫声新透绿窗纱"]},{"title":"春怨","author":"刘方平","dynasty":"唐","lines":["纱窗日落渐黄昏","金屋无人见泪痕","寂寞空庭春欲晚","梨花满地不开门"]},{"title":"登鹳雀楼","author":"王之涣","dynasty":"唐","lines":["白日依山尽","黄河入海流","欲穷千里目","更上一层楼"]},{"title":"凉州词二首","author":"王之涣","dynasty":"唐","lines":["黄河远上白云间","一片孤城万仞山","羌笛何须怨杨柳","春光不度玉门关"]},{"title":"征怨","author":"柳中庸","dynasty":"唐","lines":["岁岁金河复玉关","朝朝马策与刀环","三春白雪归青冢","万里黄河遶黑山"]},{"title":"宫词五首","author":"顾况","dynasty":"唐","lines":["玉楼天半起笙歌","风送宫嫔笑语和","月殿影开闻夜漏","水精帘卷近银河"]}]}